generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// INFOHAS ClawHub — Database Schema
// ============================================================================

// ---------------------------------------------------------------------------
// Conversations / Chat Sessions
// ---------------------------------------------------------------------------
model Conversation {
  id           String     @id @default(cuid())
  title        String     @default("New Chat")
  mode         String     @default("chat") // "chat", "agent", "swarm"
  provider     String?
  model        String?
  systemPrompt String?
  workspaceId  String?
  isArchived   Boolean    @default(false)
  isDeleted    Boolean    @default(false) // soft delete for restore
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  messages     Message[]

  @@index([workspaceId])
  @@index([isDeleted])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user", "assistant", "system", "agent-thought", "agent-action", "agent-observation"
  content        String
  metadata       String?      // JSON string for extra data
  isStreaming     Boolean      @default(false)
  isDeleted      Boolean      @default(false) // soft delete
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([isDeleted])
}

// ---------------------------------------------------------------------------
// Model Configuration — Multi-model orchestration with auxiliary models
// ---------------------------------------------------------------------------
model ModelConfig {
  id               String   @id @default(cuid())
  name             String
  provider         String   // provider type key
  contextWindow    Int      @default(128000)
  auxiliaryModels  String?  // JSON array of model IDs for delegation
  auxiliaryContext String?  // JSON array of context window sizes for aux models
  temperature      Float    @default(0.7)
  maxTokens        Int      @default(4096)
  topP             Float    @default(1.0)
  frequencyPenalty Float    @default(0.0)
  presencePenalty  Float    @default(0.0)
  priority         Int      @default(1) // 1=highest, lower = less priority
  autoOptimize     Boolean  @default(true) // hardware-aware auto config
  isActive         Boolean  @default(true)
  isDefault        Boolean  @default(false)
  modelId          String?  // actual model identifier (e.g. "gpt-4o", "claude-sonnet-4")
  baseUrl          String?  // override base URL
  apiKey           String?  // encrypted API key
  envVar           String?  // environment variable for API key
  authType         String?  // "api-key", "oauth", "cli", "device-code"
  providerConfig   String?  // JSON extra config
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Provider — All compatible providers
// ---------------------------------------------------------------------------
model Provider {
  id              String   @id @default(cuid())
  name            String
  type            String   // Provider type key
  baseUrl         String?
  apiKey          String?
  envVar          String?
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  models          String?  // JSON string of fetched models
  authType        String?  // "api-key", "oauth", "cli", "device-code"
  providerConfig  String?  // JSON string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Workspace — Persistent workspace system
// ---------------------------------------------------------------------------
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  directory   String?  // workspace root directory path
  icon        String?  // emoji or icon name
  color       String?  // tailwind color class
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  config      String?  // JSON workspace-specific config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cron Job — Scheduled task automation
// ---------------------------------------------------------------------------
model CronJob {
  id          String    @id @default(cuid())
  name        String
  description String?
  schedule    String    // cron expression (e.g. "*/5 * * * *")
  taskType    String    // "shell", "api-call", "agent-task", "model-prompt"
  taskData    String    // JSON: command, url, prompt, etc.
  workspaceId String?
  modelConfigId String?
  isActive    Boolean   @default(true)
  isRunning   Boolean   @default(false)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runCount    Int       @default(0)
  failCount   Int       @default(0)
  lastResult  String?   // JSON last execution result
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([nextRunAt])
}

// ---------------------------------------------------------------------------
// Setting — Key-value app settings
// ---------------------------------------------------------------------------
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ---------------------------------------------------------------------------
// File Attachment
// ---------------------------------------------------------------------------
model FileAttachment {
  id         String   @id @default(cuid())
  messageId  String?
  fileName   String
  filePath   String
  fileType   String?
  fileSize   Int?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Skill — Reusable prompt templates saved as .md
// ---------------------------------------------------------------------------
model Skill {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     String
  category    String   @default("general")
  isBuiltin   Boolean  @default(false)
  isActive    Boolean  @default(true)
  fileName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Plugin — Installable plugins
// ---------------------------------------------------------------------------
model Plugin {
  id          String   @id @default(cuid())
  name        String
  description String?
  version     String   @default("1.0.0")
  author      String?
  repoUrl     String?
  entryPoint  String?
  isActive    Boolean  @default(true)
  isInstalled Boolean  @default(true)
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Memory — Long-term memory with vector placeholder
// ---------------------------------------------------------------------------
model Memory {
  id          String    @id @default(cuid())
  type        String    // "fact", "preference", "context", "conversation-summary", "learned-pattern", "reflection"
  key         String?
  content     String
  source      String?
  relevance   Float     @default(1.0)
  accessCount Int       @default(0)
  tags        String?   // JSON array of tags
  embedding   String?   // JSON array of floats (vector placeholder)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([key])
}

// ---------------------------------------------------------------------------
// MCP Server configuration
// ---------------------------------------------------------------------------
model McpServer {
  id              String   @id @default(cuid())
  name            String
  command         String
  args            String?  // JSON array
  envVars         String?  // JSON object
  transportType   String   @default("stdio")
  serverUrl       String?
  isActive        Boolean  @default(false)
  isConnected     Boolean  @default(false)
  discoveredTools String?
  discoveredResources String?
  lastConnectedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Agent Swarm — parallel autonomous agents
// ---------------------------------------------------------------------------
model AgentSwarm {
  id              String   @id @default(cuid())
  name            String
  role            String
  systemPrompt    String?
  status          String   @default("idle")
  providerId      String?
  model           String?
  currentTask     String?
  taskHistory     String?  // JSON array
  workspaceDir    String?
  autoApprove     Boolean  @default(false)
  maxIterations   Int      @default(50)
  iterationCount  Int      @default(0)
  isActive        Boolean  @default(true)
  isDaemon        Boolean  @default(false)
  lastActivityAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Reflection Log
// ---------------------------------------------------------------------------
model ReflectionLog {
  id          String   @id @default(cuid())
  agentId     String?
  type        String   // "daily", "task-complete", "error-recovery", "learning"
  summary     String
  insights    String?  // JSON array
  actionItems String?  // JSON array
  successRate Float?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Hardware Profile — detected system capabilities
// ---------------------------------------------------------------------------
model HardwareProfile {
  id          String   @id @default(cuid())
  platform    String   // "win32", "linux", "darwin"
  arch        String   // "x64", "arm64"
  cpuCores    Int
  cpuModel    String?
  totalRamGB  Float
  gpuInfo     String?  // JSON
  detectedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Security Approval — command approval flow
// ---------------------------------------------------------------------------
model SecurityApproval {
  id          String    @id @default(cuid())
  actionType  String    // "shell-execute", "file-write", "file-delete", "api-call", "agent-task"
  description String
  requestedBy String?   // agent ID or user
  riskLevel   String    @default("medium") // "low", "medium", "high"
  status      String    @default("pending") // "pending", "approved", "denied", "expired"
  reviewedBy  String?
  reviewedAt  DateTime?
  metadata    String?   // JSON
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// DM Pairing — allowed DM users for messaging platforms
// ---------------------------------------------------------------------------
model DmPairing {
  id          String   @id @default(cuid())
  platform    String   // "telegram", "discord", "slack", "signal", "whatsapp"
  userId      String
  displayName String?
  isActive    Boolean  @default(true)
  addedAt     DateTime @default(now())

  @@unique([platform, userId])
}

// ---------------------------------------------------------------------------
// User Profile — active user configuration and persona
// ---------------------------------------------------------------------------
model UserProfile {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  preferences   String?  // JSON: theme, language, defaultModel, etc.
  soulMd        String?  // SOUL.md persona content
  contextFiles  String?  // JSON array of context file paths
  homeDir       String?  // Default workspace directory
  isActive      Boolean  @default(true)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Context File — reusable context files for AI system prompts
// ---------------------------------------------------------------------------
model ContextFile {
  id          String   @id @default(cuid())
  name        String
  path        String
  content     String
  category    String   @default("project") // "project", "persona", "instructions", "custom"
  isActive    Boolean  @default(true)
  autoLoad    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Kanban Board — Task management with drag-and-drop columns
// ---------------------------------------------------------------------------
model KanbanColumn {
  id        String      @id @default(cuid())
  title     String
  position  Int         @default(0)
  color     String?     // tailwind color class e.g. "bg-blue-500"
  cards     KanbanCard[]

  @@index([position])
}

model KanbanCard {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String?  // tailwind color e.g. "bg-emerald-500/10"
  priority    String   @default("medium") // "low", "medium", "high", "urgent"
  tags        String?  // JSON array of tags
  assignee    String?
  dueDate     DateTime?
  position    Int      @default(0)
  columnId    String
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([columnId])
  @@index([position])
}
